<?xml version="1.0" encoding="UTF-8" ?>
<configs>

    <!-- ============================================================
         KITSUNE FLORA ~ Biome decoration
         ============================================================
         Inject the three Kitsune trees into the pine_forest biome's
         dense-large-trees subbiome (the one carrying treeOakLrg01,
         treeFirLrg01, treeMountainPine48m, etc.).

         Probabilities are tuned to feel rare-but-discoverable:
           - Sakura in bloom: 0.002  (special, players notice)
           - Sakura in leaf:  0.003  (uncommon)
           - Keyaki:          0.004  (matches treeOakLrg01)

         Reference: F:/72D2D-Server/Data/Config/biomes.xml line ~402
         (subbiome noise=".014, 0, .38" under biome name="pine_forest")
    -->
    <append xpath="/worldgeneration/biomes/biome[@name='pine_forest']/subbiome[@noise='.014, 0, .38']/decorations">
        <decoration type="block" blockname="treeKitsuneSakura"      prob=".002" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneSakuraLeaf"  prob=".003" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneKeyaki"      prob=".004" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneDogwood"     prob=".002" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneDogwoodLeaf" prob=".003" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsunePlaneTree"   prob=".003" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneBamboo"          prob=".005" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneBlackPine"       prob=".005" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneBoxwood"         prob=".009" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsunePaintedFern"     prob=".012" rotatemax="7"/>
        <!-- Wild-grove variety: mixes ages + looks so groves aren't clones -->
        <decoration type="block" blockname="treeKitsuneBambooWildSmall" prob=".006" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneBambooWildMid"   prob=".005" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneBambooWildBig"   prob=".004" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneBoxwoodB"        prob=".009" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsuneBoxwoodC"        prob=".009" rotatemax="7"/>
        <decoration type="block" blockname="treeKitsunePaintedFernB"    prob=".012" rotatemax="7"/>
    </append>

</configs>
