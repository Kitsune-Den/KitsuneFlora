<?xml version="1.0" encoding="UTF-8" ?>
<configs>

    <!-- ============================================================
         KITSUNE FLORA ~ Japanese-themed trees
         ============================================================
         Three trees from the RoadsideTrees Unity asset, bundled via
         OCB UnityAssetExporter into Resources/Bundles/KitsuneFlora.unity3d.
         Each tree has:
           - Mature block (treeKitsuneXxx) extending vanilla treeMaster:
             choppable for resourceWood, drops a sapling on Destroy.
           - Sapling block (treePlantedKitsuneXxx1m) extending
             treeMasterGrowing: placeable on dirt, grows into the mature
             tree via PlantGrowing.Next. Sapling visual reuses vanilla
             OakSeed01 prefab so we don't have to bundle a separate small
             sprout model.

         Bundle reference syntax: #@modfolder:Resources/Bundles/X.unity3d?PrefabName
         The PrefabName must match the .prefab basename in the bundle's
         Objects list (e.g. CherryBlossom_flower_roadside_1).
    -->
    <append xpath="/blocks">

        <!-- ============================================================
             KITSUNE TREE TEMPLATE
             ============================================================
             Per War3zuk FarmLife pattern (Nexus 2108) for V2.6: define a
             template extending treeMaster with a VANILLA prefab path,
             then have actual blocks extend the template and override Model
             to the mod bundle. Registration happens against the vanilla
             path during loading; the override just swaps visual mesh.
             Without this two-step, mod-bundle blocks fail terrain
             registration → walk-through.
        -->
        <block name="treeKitsuneMaster">
            <property name="Extends" value="treeMaster"/>
            <property name="Material" value="MtreeWoodLarge"/>
            <property name="Model" value="#Entities/Trees?StudioGimbal/OakSml01/OakSml01GimbalPrefab.prefab"/>
            <property name="ModelOffset" value="0,-0.3,0"/>
            <property name="MultiBlockDim" value="1,7,1"/>
            <property name="BigDecorationRadius" value="4"/>
            <property name="ParticleOnDeath" value="treeGib_dead_01"/>
            <property name="Path" value="solid"/>
            <drop event="Harvest" name="resourceWood" count="30" tag="oreWoodHarvest,lumberjackHarvest"/>
            <property name="SortOrder1" value="B901"/>
        </block>

        <!-- ============================================================
             SAKURA (Cherry Blossom in flower) ~ iconic pink/white blooms
        -->
        <block name="treeKitsuneSakura">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneSakuraRoot"/>
            <drop event="Destroy" name="treePlantedKitsuneSakura1m" count="1"/>
            <property name="CustomIcon" value="treeKitsuneSakura"/>
            <property name="EconomicValue" value="36"/>
        </block>

        <block name="treePlantedKitsuneSakura1m">
            <property name="Extends" value="treeMasterGrowing" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsuneSakura"/>
            <property name="DescriptionKey" value="treePlantedKitsuneSakura1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneSakuraSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="14"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsuneSakura1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             SAKURA LEAF (Cherry Blossom in leaf, off-bloom variant)
        -->
        <block name="treeKitsuneSakuraLeaf">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneSakuraLeafRoot"/>
            <drop event="Destroy" name="treePlantedKitsuneSakuraLeaf1m" count="1"/>
            <property name="CustomIcon" value="treeKitsuneSakuraLeaf"/>
            <property name="EconomicValue" value="32"/>
        </block>

        <block name="treePlantedKitsuneSakuraLeaf1m">
            <property name="Extends" value="treeMasterGrowing" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsuneSakuraLeaf"/>
            <property name="DescriptionKey" value="treePlantedKitsuneSakuraLeaf1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneSakuraLeafSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="12"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsuneSakuraLeaf1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             KEYAKI (Japanese Zelkova) ~ large, broad-canopy shade tree
        -->
        <block name="treeKitsuneKeyaki">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneKeyakiRoot"/>
            <property name="MultiBlockDim" value="1,12,1"/>
            <property name="BigDecorationRadius" value="6"/>
            <drop event="Harvest" name="resourceWood" count="60" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneKeyaki1m" count="1"/>
            <property name="CustomIcon" value="treeKitsuneKeyaki"/>
            <property name="EconomicValue" value="48"/>
        </block>

        <block name="treePlantedKitsuneKeyaki1m">
            <property name="Extends" value="treeMasterGrowing" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsuneKeyaki"/>
            <property name="DescriptionKey" value="treePlantedKitsuneKeyaki1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneKeyakiSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="18"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsuneKeyaki1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             DOGWOOD (Hanamizuki) ~ pink flowering variant
             ============================================================
             Small ornamental tree. Two mature variants (pink + white,
             reframed as bloom + leaf) share a single seed, matching
             the sakura pattern.
        -->
        <block name="treeKitsuneDogwood">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneDogwoodRoot"/>
            <property name="MultiBlockDim" value="1,6,1"/>
            <property name="BigDecorationRadius" value="3"/>
            <drop event="Harvest" name="resourceWood" count="22" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneDogwood1m" count="1"/>
            <property name="CustomIcon" value="treeKitsuneDogwood"/>
            <property name="EconomicValue" value="34"/>
        </block>

        <!-- ============================================================
             DOGWOOD ~ white flowering variant (leaf-slot)
        -->
        <block name="treeKitsuneDogwoodLeaf">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneDogwoodLeafRoot"/>
            <property name="MultiBlockDim" value="1,6,1"/>
            <property name="BigDecorationRadius" value="3"/>
            <drop event="Harvest" name="resourceWood" count="22" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneDogwood1m" count="1"/>
            <property name="CustomIcon" value="treeKitsuneDogwoodLeaf"/>
            <property name="EconomicValue" value="30"/>
        </block>

        <block name="treePlantedKitsuneDogwood1m">
            <property name="Extends" value="treeMasterGrowing" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsuneDogwood"/>
            <property name="DescriptionKey" value="treePlantedKitsuneDogwood1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneDogwoodSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="13"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsuneDogwood1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             PLANE TREE (Suzukake-no-ki) ~ large sycamore with palmate
             ============================================================
             maple-shaped leaves. The Asset Store pack's "Plane_tree_
             roadside" prefab. NOT a ginkgo despite earlier assumption.

             A future ginkgo asset would slot in as `treeKitsuneGinko`
             using the parked icons treeKitsuneGinko.png + ginko-seed
             art. Plane tree owns its own block ID here.
        -->
        <block name="treeKitsunePlaneTree">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsunePlaneTreeRoot"/>
            <property name="MultiBlockDim" value="1,10,1"/>
            <property name="BigDecorationRadius" value="4"/>
            <drop event="Harvest" name="resourceWood" count="45" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsunePlaneTree1m" count="1"/>
            <property name="CustomIcon" value="treeKitsunePlaneTree"/>
            <property name="EconomicValue" value="40"/>
        </block>

        <block name="treePlantedKitsunePlaneTree1m">
            <property name="Extends" value="treeMasterGrowing" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsunePlaneTree"/>
            <property name="DescriptionKey" value="treePlantedKitsunePlaneTree1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsunePlaneTreeSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="16"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsunePlaneTree1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             AZALEA was here ~ removed in v0.3.2.
             The Azalea_wide.prefab is too flat-and-wide to work cleanly
             as a 7DTD block: hit registration fights with the voxel
             system and rendering breaks at small MultiBlockDim. Parking
             until we have a different azalea asset OR a better fit
             for shrub-style blocks. Icons stay in Workspace/IconSources/.
        -->

    </append>

</configs>
