            <property name="CustomIcon" value="treeKitsuneBlackPine"/>
            <property name="MultiBlockDim" value="1,7,1"/>
            <property name="BigDecorationRadius" value="4"/>
            <drop event="Harvest" name="resourceWood" count="55" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneBlackPine1m" count="1"/>
            <property name="EconomicValue" value="44"/>
        </block>

        <block name="treeKitsuneBlackPineMid">
            <property name="Extends" value="treeMasterGrowing"/>
            <property name="CreativeMode" value="None"/>
            <property name="PlantGrowing.Next" value="treeKitsuneBlackPine"/>
            <property name="Material" value="MtreeWoodMedium"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneBlackPineMidRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="MultiBlockDim" value="1,3,1"/>
            <property name="Path" value="solid"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <drop event="Harvest" name="resourceWood" count="22" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneBlackPine1m" count="1"/>
        </block>

        <block name="treePlantedKitsuneBlackPine1m">
            <property name="Extends" value="treeMasterGrowing" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsuneBlackPineMid"/>
            <property name="DescriptionKey" value="treePlantedKitsuneBlackPine1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneBlackPineSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="14"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsuneBlackPine1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             BOXWOOD (Tsuge) ~ decorative shrub, 2-stage plantable
             ============================================================
             Single mesh, no growth chain. Planted seed uses the vanilla
             oak sprout, then grows straight to the boxwood shrub.
             1x2x1 block so DistantDecoTree rendering has vertical room.
        -->
        <block name="treeKitsuneBoxwood">
            <property name="Extends" value="treeKitsuneGroveMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneBoxwoodRoot"/>
            <property name="CustomIcon" value="treeKitsuneBoxwood"/>
            <property name="MultiBlockDim" value="1,2,1"/>
            <property name="BigDecorationRadius" value="0"/>
            <drop event="Destroy" name="resourceWood" count="6" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneBoxwood1m" count="1"/>
            <property name="EconomicValue" value="16"/>
        </block>

        <block name="treePlantedKitsuneBoxwood1m">
            <!-- See treePlantedKitsuneBamboo1m: cropsGrowingMaster is the
                 crop-row base so boxwood shrubs can be planted in dense
                 hedges instead of tree-spaced. -->
            <property name="Extends" value="cropsGrowingMaster" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsuneBoxwood"/>
            <property name="PlantGrowing.FertileLevel" value="1"/>
            <property name="DescriptionKey" value="treePlantedKitsuneBoxwood1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Shape" value="ModelEntity"/>
            <!-- Real boxwood mesh at 0.5 scale (treeKitsuneBoxwoodSmallRoot)
                 so a planted boxwood seed reads as a young shrub, not the
                 oak sprout it used to share with the fern seed. -->
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneBoxwoodSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="MultiBlockDim" value="1,2,1"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="8"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsuneBoxwood1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             PAINTED FERN (Nishikishida) ~ ground plant, 2-stage plantable
             ============================================================
             Low ground-cover fern. Same 2-stage pattern as boxwood.
        -->
        <block name="treeKitsunePaintedFern">
            <property name="Extends" value="treeKitsuneGroveMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsunePaintedFernRoot"/>
            <property name="ModelOffset" value="0,0,0"/>
            <property name="CustomIcon" value="treeKitsunePaintedFern"/>
