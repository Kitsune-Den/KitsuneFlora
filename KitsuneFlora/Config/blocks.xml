            <drop event="Harvest" name="treePlantedKitsuneKeyaki1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             DOGWOOD (Hanamizuki) ~ pink flowering variant
             ============================================================
             Small ornamental tree. Two mature variants (pink + white,
             reframed as bloom + leaf) share a single seed, matching
             the sakura pattern.
        -->
        <block name="treeKitsuneDogwood">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneDogwoodRoot"/>
            <property name="MultiBlockDim" value="1,6,1"/>
            <property name="BigDecorationRadius" value="3"/>
            <drop event="Harvest" name="resourceWood" count="22" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneDogwood1m" count="1"/>
            <property name="CustomIcon" value="treeKitsuneDogwood"/>
            <property name="EconomicValue" value="34"/>
        </block>

        <!-- ============================================================
             DOGWOOD ~ white flowering variant (leaf-slot)
        -->
        <block name="treeKitsuneDogwoodLeaf">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneDogwoodLeafRoot"/>
            <property name="MultiBlockDim" value="1,6,1"/>
            <property name="BigDecorationRadius" value="3"/>
            <drop event="Harvest" name="resourceWood" count="22" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneDogwood1m" count="1"/>
            <property name="CustomIcon" value="treeKitsuneDogwoodLeaf"/>
            <property name="EconomicValue" value="30"/>
        </block>

        <block name="treePlantedKitsuneDogwood1m">
            <property name="Extends" value="treeMasterGrowing" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsuneDogwood"/>
            <property name="DescriptionKey" value="treePlantedKitsuneDogwood1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneDogwoodSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="13"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsuneDogwood1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             PLANE TREE (Suzukake-no-ki) ~ large sycamore with palmate
             ============================================================
             maple-shaped leaves. The Asset Store pack's "Plane_tree_
             roadside" prefab. NOT a ginkgo despite earlier assumption.

             A future ginkgo asset would slot in as `treeKitsuneGinko`
             using the parked icons treeKitsuneGinko.png + ginko-seed
             art. Plane tree owns its own block ID here.
        -->
        <block name="treeKitsunePlaneTree">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsunePlaneTreeRoot"/>
            <property name="MultiBlockDim" value="1,10,1"/>
            <property name="BigDecorationRadius" value="4"/>
            <drop event="Harvest" name="resourceWood" count="45" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsunePlaneTree1m" count="1"/>
            <property name="CustomIcon" value="treeKitsunePlaneTree"/>
            <property name="EconomicValue" value="40"/>
        </block>

        <block name="treePlantedKitsunePlaneTree1m">
            <property name="Extends" value="treeMasterGrowing" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsunePlaneTree"/>
            <property name="DescriptionKey" value="treePlantedKitsunePlaneTree1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsunePlaneTreeSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="16"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsunePlaneTree1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             AZALEA was here ~ removed in v0.3.2.
             The Azalea_wide.prefab is too flat-and-wide to work cleanly
             as a 7DTD block: hit registration fights with the voxel
             system and rendering breaks at small MultiBlockDim. Parking
             until we have a different azalea asset OR a better fit
             for shrub-style blocks. Icons stay in Workspace/IconSources/.
        -->

        <!-- ============================================================
             BAMBOO (Take) ~ TRUE 3-stage growth chain
             ============================================================
             FreeJapaneseGarden pack ships real Small/Mid/Big meshes, so
             a planted Bamboo Seed visibly grows through three distinct
             models:
               treePlantedKitsuneBamboo1m  (Small mesh) ─grow→
               treeKitsuneBambooMid        (Mid mesh)   ─grow→
               treeKitsuneBamboo           (Big mesh, mature)
             No CustomIcon yet — 7DTD generates procedural icons from the
             mesh until real icon art is drawn.
        -->
        <!-- v0.3.8: switched from treeKitsuneGroveMaster (plain ModelEntity)
             to treeKitsuneMaster (ModelTree) so mature bamboo fells like a
             vanilla 7DTD tree ~ chopping the bottom block topples the whole
             trunk and despawns the rest, instead of having to chop each
             of the 6 stacked cells individually. Player-placement spacing
             constraints don't matter for bamboo because seeds use the crop
             base and biome decoration ignores ModelTree's spacing check. -->
        <block name="treeKitsuneBamboo">
            <property name="Extends" value="treeKitsuneMaster"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneBambooRoot"/>
            <property name="CustomIcon" value="treeKitsuneBamboo"/>
            <property name="MultiBlockDim" value="1,6,1"/>
            <property name="BigDecorationRadius" value="0"/>
            <drop event="Harvest" name="resourceWood" count="35" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneBamboo1m" count="1"/>
            <property name="EconomicValue" value="34"/>
        </block>

        <block name="treeKitsuneBambooMid">
            <property name="Extends" value="treeMasterGrowing"/>
            <property name="CreativeMode" value="None"/>
            <property name="PlantGrowing.Next" value="treeKitsuneBamboo"/>
            <property name="BigDecorationRadius" value="0"/>
            <property name="Material" value="MtreeWoodSmall"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneBambooMidRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="MultiBlockDim" value="1,3,1"/>
            <property name="Path" value="solid"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <drop event="Harvest" name="resourceWood" count="15" tag="oreWoodHarvest,lumberjackHarvest"/>
            <drop event="Destroy" name="treePlantedKitsuneBamboo1m" count="1"/>
        </block>

        <block name="treePlantedKitsuneBamboo1m">
            <!-- Extends cropsGrowingMaster, NOT treeMasterGrowing. The vanilla
                 tree base is Class="ModelTree", and ModelTree enforces a
                 minimum tree-to-tree spacing in C# at player-placement time
                 ~ no XML property (not BigDecorationRadius, not a Class
                 override) can defeat it, so bamboo seeds could never be
                 planted adjacent. cropsGrowingMaster is the crop-row base
                 (Class="PlantGrowing", no BigDecorationRadius): it plants in
                 tight groves exactly like corn. We drop FertileLevel from the
                 crop default of 15 back to 1 so bamboo still plants on plain
                 dirt rather than only on farm plots, and override Shape to
                 ModelEntity so the bundled 3D mesh renders (the crop base
                 ships Shape="BillboardPlant"). -->
            <property name="Extends" value="cropsGrowingMaster" param1="CustomIcon"/>
            <property name="CreativeMode" value="Player"/>
            <property name="FallOver" value="false"/>
            <property name="PlaceAsRandomRotation" value="true"/>
            <property name="PlantGrowing.Next" value="treeKitsuneBambooMid"/>
            <property name="PlantGrowing.FertileLevel" value="1"/>
            <property name="DescriptionKey" value="treePlantedKitsuneBamboo1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Shape" value="ModelEntity"/>
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsuneBambooSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="MultiBlockDim" value="1,2,1"/>
            <property name="ParticleOnDeath" value="treeGib_sapling"/>
            <property name="Collide" value="melee"/>
            <property name="StabilitySupport" value="false"/>
            <property name="EconomicValue" value="12"/>
            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsuneBamboo1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             BLACK PINE (Kuromatsu) ~ TRUE 3-stage growth chain
             ============================================================
             Same 3-stage pattern as bamboo. Sturdy, slow, heavy-wood
