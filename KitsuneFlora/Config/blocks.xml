            <property name="EconomicBundleSize" value="5"/>
            <property name="SellableToTrader" value="false"/>
            <property name="MaxDamage" value="10"/>
            <property name="ActivationDistance" value="4"/>
            <dropextendsoff/>
            <drop event="Harvest" name="treePlantedKitsunePaintedFern1m" count="1" tag="lumberjackHarvest"/>
        </block>

        <!-- ============================================================
             WILD-GROVE VARIETY BLOCKS
             ============================================================
             Decoration-only variants that share their base type's name,
             seed drop, and behavior — they just use a different mesh so
             a wild grove isn't 50 identical clones. No growth chain
             (terminal); biome decoration spawns them mixed with the
             chain blocks. Choppable; drop the matching seed.

             Bamboo: the _02 mesh set at all three sizes — so a wild
             bamboo grove has mixed ages AND mixed looks.
             Boxwood / Painted Fern: extra Spring variants.
        -->
        <!-- v0.3.8: same switch from treeKitsuneGroveMaster to treeKitsuneMaster
             as the planted bamboo above ~ wild biome-spawned bamboo now fells
             like a vanilla tree too. -->
        <block name="treeKitsuneBambooWildSmall">
