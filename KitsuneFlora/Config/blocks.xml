            <property name="DescriptionKey" value="treePlantedKitsunePaintedFern1mDesc"/>
            <property name="Material" value="Mplants"/>
            <property name="Shape" value="ModelEntity"/>
            <!-- Real fern mesh at 0.5 scale (treeKitsunePaintedFernSmallRoot)
                 so a planted fern seed reads as a young fern, not the oak
                 sprout it used to share with the boxwood seed. -->
            <property name="Model" value="#@modfolder:Resources/Bundles/KitsuneFlora.unity3d?treeKitsunePaintedFernSmallRoot"/>
            <property name="ModelOffset" value="0,-0.1,0"/>
            <property name="MultiBlockDim" value="1,2,1"/>
